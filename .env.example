# Claude API（画像・キャプションからの店舗判定 /analyze で使用）
# 未設定でもキーワード判定で動きます。
ANTHROPIC_API_KEY=
# 使うモデル（未設定なら claude-haiku-5-5）
ANTHROPIC_MODEL=

# OpenAI APIを使う場合だけ設定してください。
# 未設定でも、簡易ルールベース抽出で動作確認できます。
OPENAI_API_KEY=

# SQLiteの保存先です。未設定の場合は ./insta_bookmark.db を使います。
DATABASE_URL=sqlite:///./insta_bookmark.db
